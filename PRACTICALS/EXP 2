
#include <stdio.h>

int main() {
    char text[100], key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i;

    printf("Enter message: ");
    scanf("%s", text);

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            text[i] = key[text[i] - 'A'];
        else if (text[i] >= 'a' && text[i] <= 'z')
            text[i] = key[text[i] - 'a'] + 32;
    }

    printf("Encrypted message: %s", text);

    return 0;
}

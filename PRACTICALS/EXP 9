#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[]) {
    int used[26] = {0};
    int r = 0, c = 0, i;
    char ch;

    used['J' - 'A'] = 1;

    for (i = 0; i < (int)strlen(key) + 26; i++) {
        if (i < (int)strlen(key))
            ch = toupper((unsigned char)key[i]);
        else
            ch = 'A' + i - strlen(key);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A']) {
            matrix[r][c++] = ch;
            used[ch - 'A'] = 1;

            if (c == 5) {
                c = 0;
                r++;
            }
        }
    }
}

void findPosition(char ch, int *r, int *c) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

int main() {
    char key[] = "MONARCHY";
    char input[1000], text[1000];
    int i, n = 0, r1, c1, r2, c2;

    createMatrix(key);

    printf("Keyword: %s\n", key);
    printf("Playfair matrix:\n");

    for (i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nEnter ciphertext (4 lines):\n");

    for (i = 0; i < 4; i++) {
        if (fgets(input, sizeof(input), stdin) == NULL)
            return 1;

        for (int j = 0; input[j] != '\0'; j++) {
            if (isalpha((unsigned char)input[j])) {
                char ch = toupper((unsigned char)input[j]);
                text[n++] = (ch == 'J') ? 'I' : ch;
            }
        }
    }

    text[n] = '\0';

    if (n % 2 != 0) {
        printf("Error: odd number of letters in ciphertext.\n");
        return 1;
    }

    printf("\nDecrypted text:\n");

    for (i = 0; i < n; i += 2) {
        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        if (r1 == r2) {
            putchar(matrix[r1][(c1 + 4) % 5]);
            putchar(matrix[r2][(c2 + 4) % 5]);
        } else if (c1 == c2) {
            putchar(matrix[(r1 + 4) % 5][c1]);
            putchar(matrix[(r2 + 4) % 5][c2]);
        } else {
            putchar(matrix[r1][c2]);
            putchar(matrix[r2][c1]);
        }
    }

    printf("\n");
    return 0;
}
